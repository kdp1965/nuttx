#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_LISA

choice
	prompt "LISA chip"
	default ARCH_CHIP_LISA

config ARCH_CHIP_LISA
	bool "LISA rev 3 (ttsky26d twenty-four-bit)"
	select ARCH_NOINTC
	select MM_SMALL
	---help---
		Ken Pettit's LISA (Little ISA) 8-bit microcontroller, the third
		chip (ttsky26d-um-lisa-ttlc, REV3.md): 2M words of code in 128
		banks reached through 24-bit code pointers, a flat 8 MB of data,
		built with sdcc -mlisa --rev3 --model-huge.

endchoice

config ARCH_CHIP
	string
	default "lisa"		if ARCH_CHIP_LISA

source "arch/lisa/src/common/Kconfig"
source "arch/lisa/src/lisa/Kconfig"
endif
