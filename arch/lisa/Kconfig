#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_LISA

choice
	prompt "LISA chip"
	default ARCH_CHIP_LISA

config ARCH_CHIP_LISA
	bool "LISA rev 2 (ttsky26d)"
	select ARCH_NOINTC
	select MM_SMALL
	---help---
		Ken Pettit's LISA (Little ISA) 8-bit microcontroller, the second
		chip (ttsky26d-um-lisa-ttlc): 1M words of code in 64 banks, 32K of
		flat data, built with sdcc -mlisa --rev2 --model-huge.

endchoice

config ARCH_CHIP
	string
	default "lisa"		if ARCH_CHIP_LISA

source "arch/lisa/src/common/Kconfig"
source "arch/lisa/src/lisa/Kconfig"
endif
