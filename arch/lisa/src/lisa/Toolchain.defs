# The toolchain is sdcc -mlisa (lisa-tools/sdcc-lisa, README-lisa.md), built
# in place: CONFIG_LISA_SDCC_PATH is its build directory (bin/sdcc,
# share/sdcc/lib/lisa-rev3), relative to the NuttX top directory unless
# absolute.

SDCC_INSTALLDIR := $(patsubst "%",%,$(CONFIG_LISA_SDCC_PATH))
ifeq ($(filter /%,$(SDCC_INSTALLDIR)),)
  SDCC_INSTALLDIR := $(TOPDIR)/$(SDCC_INSTALLDIR)
endif
SDCC_BINDIR = $(SDCC_INSTALLDIR)/bin
LISA_TOOLS = $(TOPDIR)/arch/lisa/src/tools

# The third chip (--rev3: 24-bit IX / SP / RA, 3-byte pointers, a flat 8 MB,
# the constants packed) in the huge model (--model-huge: every function
# reached through its 24-bit pointer unless __nonbanked, data far).
# lisa-sdcc adds the code bank of each source (--codeseg BANKn) from the
# board's bank map.

ifeq ($(CONFIG_LISA_REV3),y)
  # the third chip: 24-bit pointers, the flat data space (REV3.md)
  SDCC_LIBDIR = $(SDCC_INSTALLDIR)/share/sdcc/lib/lisa-rev3
  ARCHCPUFLAGS = -mlisa --rev3 --model-huge
else
  SDCC_LIBDIR = $(SDCC_INSTALLDIR)/share/sdcc/lib/lisa-rev2k
  ARCHCPUFLAGS = -mlisa --rev2 --pack-const --model-huge
endif

ifeq ($(CONFIG_DEBUG_SYMBOLS),y)
  ARCHOPTIMIZATION = --debug
endif

export LISA_SDCC = $(SDCC_BINDIR)/sdcc
export LISA_CPUFLAGS = $(ARCHCPUFLAGS)
export LISA_BANK_MAP = $(TOPDIR)/boards/$(patsubst "%",%,$(CONFIG_ARCH))/$(patsubst "%",%,$(CONFIG_ARCH_CHIP))/$(patsubst "%",%,$(CONFIG_ARCH_BOARD))/scripts/banks.map

# Custom ASSEMBLE definition: the assembler is run directly (no
# preprocessing), as for the other SDCC targets.

define ASSEMBLE
	@echo "AS: $1"
	$(Q) $(AS) $(AFLAGS) $($(strip $1)_AFLAGS) $2 $1
endef

# Custom CLEAN definition: sdcc leaves its intermediate files beside the
# object

define CLEAN
	$(Q) rm -f *.o *.asm *.rel *.lst *.rst *.sym *.adb *.lnk *.map *.mem *.ihx *.cdb
endef

# Tool names/paths

CC = $(LISA_TOOLS)/lisa-sdcc
CPP = $(LISA_TOOLS)/lisa-cpp
LD = $(SDCC_BINDIR)/sdldlisa
AS = $(SDCC_BINDIR)/sdaslisa
AR = $(LISA_TOOLS)/lisa-ar

# File extensions

ASMEXT = .asm
OBJEXT = .rel
LIBEXT = .lib
EXEEXT = .ihx
