#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_LISA

choice
	prompt "Toolchain Selection"
	default LISA_TOOLCHAIN_SDCC

config LISA_TOOLCHAIN_SDCC
	bool "sdcc -mlisa (lisa-tools/sdcc-lisa)"

endchoice

config LISA_SDCC_PATH
	string "sdcc build directory"
	default "../lisa-tools/sdcc-lisa/build"
	---help---
		The build directory of sdcc-lisa (bin/sdcc, share/sdcc/lib/lisa-rev2),
		relative to the NuttX top directory unless absolute.

config LISA_REV3
	bool "The third chip: 24-bit registers, a flat 8 MB data space"
	default y
	select ARCH_WIDE_HEAP
	---help---
		The twenty-four-bit chip (ttsky26d REV3.md): IX, SP and the return
		addresses are 24 bits, pointers 3 bytes (sdcc --rev3, the library
		lisa-rev3), the data space the flat 8 MB with no banks - one heap
		from the end of the data areas to the idle thread's stack, in
		regions of 64 KB (size_t is 16 bits), so MM_REGIONS has to cover
		the RAM (130 for 8 MB).  Without it the kernel is built for the
		second chip (sdcc --rev2, the task banks optional).

config LISA_TASK_BANKS
	bool "Task banks: each task's stack in a stack bank, its heap in a granule"
	default n
	depends on !LISA_REV3
	select ARCH_BANKED_TASKS
	select MM_KERNEL_HEAP
	---help---
		The second chip's data space (RESPIN 28) is the common 8 KB below
		0x2000, the data window 0x2000-0x3FFF on one of 32 granules of
		8 KB and the stack window 0x4000-0x7FFF on one of 16 banks of
		16 KB, by address.  With this option the kernel's data and heap
		stay in the common 8 KB, visible to every task, and each task
		gets a granule for the heap its malloc() draws from and a stack
		in a stack bank: a small stack shares a bank with other tasks'
		stacks, a stack of LISA_TASK_OWN_BANK_STACK bytes or more gets a
		bank of its own, and the task's heap then runs from 0x2000 up to
		its stack, 24 KB less the stack.  A pthread's stack comes from
		its group's heap; the kernel threads share bank 1 and granule 1
		with the idle thread.  A heap pointer is valid only under its
		own granule: tasks share memory through the kernel (pipes,
		files, message queues), not by pointer.  The kernel reaches a
		task's stack or heap through a visit on a scratch stack in the
		common 8 KB (lisa_bank_call).  /proc/meminfo lists the kernel
		heap, the calling task's heap, each stack bank and the total of
		all 31 granules.

		Without it the data space is the flat 32 KB: one heap, every
		stack in it.

config LISA_SCHED_TRACE
	bool "A context-switch trace and UART receive counters, read with xd"
	default n
	---help---
		A debugging aid: a ring of the last 64 context switches (the pid
		switched from, the pid switched to, how - 1 a switch, 2 + 16 x the
		irq an interrupt, 3 an exit - and the low byte of the tick) in
		g_swtrace with its index g_swidx, and in the UART driver counters
		of the bytes taken from the receive FIFO, the overruns seen and the
		receive interrupt disables and enables (g_lisa_rx_bytes, _ovr,
		_off, _on).  Read them with nsh's xd at the addresses nuttx.map
		gives (arch/lisa/src/nuttx.map).

config LISA_TASK_OWN_BANK_STACK
	int "Stack size from which a task gets a bank of its own"
	default 4096
	depends on LISA_TASK_BANKS
	---help---
		A task created with a stack of at least this many bytes takes a
		free stack bank for itself: the stack at the top, the task's heap
		from the data window up to it (24 KB less the stack).  A smaller
		stack goes to the first shared bank with room, a new one when none
		has, and the task's heap is its 8 KB granule.

endif
